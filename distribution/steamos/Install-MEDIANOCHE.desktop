[Desktop Entry]
Type=Application
Name=Instalar MEDIANOCHE
Comment=Instalar MEDIANOCHE y sus ilustraciones en Steam
Exec=python3 -c "import os,sys; from pathlib import Path; from urllib.parse import urlparse,unquote; p=sys.argv[1]; p=unquote(urlparse(p).path) if p.startswith('file:') else p; os.execv('/bin/sh',['sh',str(Path(p).parent/'install.sh')])" %k
Icon=steam
Terminal=true
Categories=Game;
StartupNotify=false
